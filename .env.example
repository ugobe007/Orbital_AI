# Orbital AI Cloud configuration (copy to .env; never commit .env)

# --- Server ---
ORBITAL_HOST=0.0.0.0
ORBITAL_PORT=8090

# --- Facility / seed fleet ---
ORBITAL_FACILITY_ID=facility-sf-001
ORBITAL_FACILITY_NAME=StageGate SF Pilot

# --- Simulated ARIA edge ---
# The built-in simulator stands in for a real ARIA Edge Node so the whole
# monitor+control stack is demoable without cameras/robots. Set to 0 to disable
# and drive the cloud purely from real edge nodes posting to /api/v1/telemetry.
ORBITAL_SIMULATOR_ENABLED=1
ORBITAL_SIM_TICK_HZ=5

# --- Safety thresholds (meters) — shared by cloud + ARIA edge ---
# Degradation event threshold (MTBD is measured against this).
ORBITAL_DRIFT_DEGRADED_M=0.1
# Safety-halt threshold: drift beyond this triggers an E-Stop + alert.
ORBITAL_HALT_THRESHOLD_M=0.5

# --- Orchestrator (autonomy layer) ---
ORBITAL_ORCHESTRATOR_ENABLED=1
ORBITAL_ORCHESTRATOR_INTERVAL_S=5
ORBITAL_LOW_BATTERY_PCT=25
# Optional LLM narrative on top of the deterministic policy (advisory only).
ORBITAL_LLM_ENABLED=0
ORBITAL_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- OEM scope enforcement (control path) ---
# Unmanaged vendors (no OEM registered) are permissive by default so the seed demo
# fleet stays controllable. Set to 1 to deny control to any vendor without an OEM grant.
# Production: ORBITAL_STRICT_OEM_SCOPES=1
ORBITAL_STRICT_OEM_SCOPES=0

# --- OEM credentials (Fly secrets / vault — never commit real values) ---
# Resolved by fleet_adapters.secrets.resolve_oem_credentials on adapter.connect().
# Aliases: SPOT|BD, ARC|AGILITY, UNITREE, AGIBOT|AIMDK, DEEP|LITE3, FOURIER|AURORA, MAGICLAB, PUDU
# ORBITAL_SECRET_SPOT_JSON={"username":"...","password":"..."}
# ORBITAL_SECRET_ARC_API_KEY=
# ORBITAL_SECRET_PUDU_JSON={"app_key":"...","app_secret":"...","host":"https://open-platform-test.pudutech.com"}
# ORBITAL_SECRET_PUDU_API_KEY=   # ApiAppKey
# ORBITAL_SECRET_PUDU_APP_SECRET=  # ApiAppSecret
# ORBITAL_SECRET_AGIBOT_JSON={"map_id":"1"}
# fly secrets set ORBITAL_SECRET_ARC_API_KEY=... ORBITAL_SECRET_SPOT_JSON='...'

# --- Persistence (optional) ---
# When set, OEM grants + operator waypoints are persisted to a SQLite file so they
# survive restarts. Unset = pure in-memory (local dev / tests). On Fly this points at
# a mounted volume (see fly.toml [mounts]). Live fleet motion is always ephemeral.
# ORBITAL_DB_PATH=/data/orbital.db
# Seed a few demo OEM partners (varied grant levels) at startup for the governance panel.
ORBITAL_SEED_OEMS=1

# --- TelemetryStore (optional Influx dual-write; reads stay in-memory) ---
# ORBITAL_INFLUX_URL=http://localhost:8086
# ORBITAL_INFLUX_TOKEN=
# ORBITAL_INFLUX_ORG=orbital
# ORBITAL_INFLUX_BUCKET=aria_drift

# --- Dashboard RBAC (off by default for demos; set 1 in production) ---
# Production checklist: ORBITAL_RBAC_ENFORCE=1 + tokens set + STRICT_OEM_SCOPES=1
# Smoke: python3 scripts/check_prod_security.py --strict
# ORBITAL_RBAC_ENFORCE=0
# ORBITAL_RBAC_TOKENS=admin:change-me,operator:change-me,viewer:change-me

# --- Deploy (local / CI only; never commit real tokens) ---
# Create with: fly tokens create deploy -a orbital-ai -n orbital-github-ci
# Laptop: Orbital_AI/.env → FLY_API_TOKEN
# GitHub Actions: ugobe007/Orbital_AI secret FLY_API_TOKEN (not StageGate)
# FLY_API_TOKEN=

# --- ARIA Edge Node (aria_edge/) ---
# Where an edge node syncs telemetry/alerts (outbound-only, mTLS in prod).
ARIA_FACILITY_ID=facility-sf-001
ORBITAL_CLOUD_URL=http://localhost:8090
# ORBITAL_CLOUD_API_KEY=
# Optional mTLS (generate with scripts/gen_mtls_certs.sh):
# ORBITAL_MTLS_CERT=scripts/mtls/certs/client.crt
# ORBITAL_MTLS_KEY=scripts/mtls/certs/client.key
# ORBITAL_MTLS_CA=scripts/mtls/certs/ca.crt

# --- Lab cutover (Sprint D) ---
# ARIA_CV_MODE=sim
# ARIA_CV_MODE=aruco
# ARIA_ARUCO_FIXTURE=testdata/aruco/frame_001.json
# ARIA_ARUCO_MARKER_MAP=testdata/aruco/marker_map.example.json
# ARIA_UNITREE_HARDWARE=0
# ARIA_CLOUD_SYNC=0
ARIA_CONTROL_HZ=10
ARIA_CORRECTION_GAIN=1.5
ARIA_MAX_CORRECTION_MPS=0.4
ARIA_LOOKAHEAD_M=0.20
